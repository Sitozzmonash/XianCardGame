# 真实后端地址（FastAPI，见 docs/API_CONTRACT.md §2）
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# mock 开关（默认关闭 = 真后端）：
#   不设置 或 =0  → 全部请求打到 EXPO_PUBLIC_API_BASE_URL
#   =1 / true / yes → 使用 src/api/mock.ts 的内置演示数据（无需后端即可走完一局）
# 注意：后端不可用时，App 首页也会提供「使用演示数据」按钮在运行期临时切换，无需重新构建。
EXPO_PUBLIC_USE_MOCK=0

# 单次请求超时（毫秒，可选）
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000
