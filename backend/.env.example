# Copy to backend/.env for local development. Never commit backend/.env.
# In Vercel, add these under the backend Service environment variables.

# Required in Vercel: the full Neon PostgreSQL connection string.
DATABASE_URL=

APP_ENV=development
LOG_LEVEL=INFO
MODEL_DIR=models
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=200

# Keep both deployed AI algorithms available while limiting serverless latency.
DEFAULT_ISMCTS_SIMULATIONS=200
ISMCTS_MAX_SIMULATIONS=500
MAX_AI_STEPS_PER_REQUEST=4000
