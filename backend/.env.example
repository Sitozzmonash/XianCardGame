# 后端环境变量示例：复制为 .env 后按需修改
# cp .env.example .env

# 运行环境：development / production
APP_ENV=development

# 允许的跨域来源，逗号分隔；* 表示全部放行（仅开发用）
CORS_ORIGINS=*

# 默认 ISMCTS 模拟次数（前端未显式指定时使用）
DEFAULT_ISMCTS_SIMULATIONS=500

# API 侧允许的最大 ISMCTS 模拟次数（防止一次请求搜索过久）
ISMCTS_MAX_SIMULATIONS=2000

# MCCFR 模型目录（相对 backend/）
MODEL_DIR=models

# 游戏 session 空闲存活秒数，超时自动回收
SESSION_TTL_SECONDS=3600

# 进程内最大 session 数
MAX_SESSIONS=200

# 单局最大决策步数（防止死循环，达到即按平局结束）
MAX_DECISIONS=500
