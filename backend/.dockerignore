# 构建上下文排除项（backend/）
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.env

# MCCFR 模型体积大（2 人 10K ≈ 23MB、3 人 10K ≈ 51MB，加 checkpoint 上百 MB），
